#owner: oceanbase
#owner group: shenzhen

connection default;

# AI_PROMPT: JSON 参数、重复占位符和 LOB 输入
select ai_prompt('{0}/{0}/{1}', json_array(1,true), json_object('k',2));
--disable_warnings
drop table if exists ai_enhance_prompt;
--enable_warnings
create table ai_enhance_prompt(t longtext, a text);
insert into ai_enhance_prompt values('{0}-ok', 'lob');
select ai_prompt(t, a) from ai_enhance_prompt;
drop table ai_enhance_prompt;

# OpenAI completion/embed/rerank mock endpoints
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_complete');
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_complete_ep');
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
  'enhance_complete', '{"type":"completion","model_name":"qwen3-32b"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT(
  'enhance_complete_ep', '{"ai_model_name":"enhance_complete","scope":"all","url":"http://0.0.0.0:8000/compatible-mode/v1/chat/completions","access_key":"mock-key","provider":"openai"}');
select length(ai_complete('enhance_complete', 'hello', null)) > 0 as complete_ok;
select length(ai_complete(
  'enhance_complete', ai_prompt('describe {0}', json_object('text','你好')),
  '{"temperature":0.2,"max_tokens":16}')) > 0 as complete_config_ok;
select length(ai_complete('enhance_complete', 'hello')) > 0 as complete_omitted_ok;
select length(ai_complete('enhance_complete', 'hello', json_object('temperature', 0.2, 'max_tokens', 16))) > 0 as complete_json_ok;
select length(ai_complete('enhance_complete', cast(repeat('abc', 1024) as char))) > 0 as complete_long_ok;

--disable_query_log
--disable_result_log
--error 1210
select ai_complete('enhance_complete', null);
--error 1210
select ai_complete('enhance_complete', '');
--error 1210
select ai_complete('enhance_complete', 'hello', '[]');
--error 1210
select ai_complete('enhance_complete', 'hello', json_array(1));
--error 1210
select ai_complete('enhance_complete', 'hello', '{"temperature":2.1}');
--error 1210
select ai_complete('enhance_complete', 'hello', '{"temperature":"0.2"}');
--error 1210
select ai_complete('enhance_complete', 'hello', '{"max_tokens":0}');
--error 1210
select ai_complete('enhance_complete', 'hello', '{"max_tokens":1.5}');
--enable_result_log
--enable_query_log

--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_embed');
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_embed_ep');
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
  'enhance_embed', '{"type":"dense_embedding","model_name":"text-embedding-v1"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT(
  'enhance_embed_ep', '{"ai_model_name":"enhance_embed","scope":"all","url":"http://0.0.0.0:8000/compatible-mode/v1/embeddings","access_key":"mock-key","provider":"openai"}');
select json_length(ai_embed('enhance_embed', 'single-row')) as embed_dimension;
select json_length(ai_embed('enhance_embed', 'dimension-row', 768)) as requested_dimension;

# Rejected dimensions must fail before calling the endpoint.
--disable_query_log
--disable_result_log
--error 1210
select ai_embed('enhance_embed', 'invalid-dimension', 0);
--error 1210
select ai_embed('enhance_embed', 'invalid-dimension', -1);
--error 1210
select ai_embed('enhance_embed', 'invalid-dimension', 1.5);
--error 1210
select ai_embed('enhance_embed', 'invalid-dimension', '768');
--error 1210
select ai_embed('enhance_embed', 'invalid-dimension', null);
--error 1210
select ai_embed('enhance_embed', 'invalid-dimension', cast(null as signed));
--error 1210
select ai_embed('enhance_embed', 'invalid-dimension', cast(18446744073709551615 as unsigned));
--enable_result_log
--enable_query_log

# 多行在表达式 batch 回调中合并请求；NULL 行不进入请求也不导致结果错位
--disable_warnings
drop table if exists ai_enhance_batch;
--enable_warnings
create table ai_enhance_batch(id int primary key, content text);
insert into ai_enhance_batch values(1,'first'),(2,null),(3,'third');
select id, json_length(ai_embed('enhance_embed', content)) as dimension
  from ai_enhance_batch order by id;

# A scan with enough active rows for a full provider batch and a tail.
insert into ai_enhance_batch values (4,null),(5,null),(6,'row-6'),(7,'row-7'),(8,'row-8'),(9,'row-9'),(10,'row-10'),(11,'row-11'),(12,'row-12'),(13,'row-13'),(14,'row-14'),(15,'row-15'),(16,'row-16'),(17,'row-17'),(18,'row-18'),(19,'row-19'),(20,'row-20'),(21,'row-21'),(22,'row-22'),(23,'row-23'),(24,'row-24'),(25,'row-25'),(26,'row-26'),(27,'row-27'),(28,'row-28'),(29,'row-29'),(30,'row-30'),(31,'row-31'),(32,'row-32'),(33,'row-33'),(34,'row-34'),(35,'row-35'),(36,'row-36'),(37,'row-37'),(38,null),(39,'row-39'),(40,'row-40'),(41,'row-41'),(42,'row-42'),(43,null),(44,'');
select /*+ opt_param('rowsets_max_rows', 64) */ sum(json_length(ai_embed('enhance_embed', content)) = 768) as batch_vectors from ai_enhance_batch where id < 44;
select /*+ opt_param('rowsets_max_rows', 64) */ sum(ai_embed('enhance_embed', content) is null) as all_null from ai_enhance_batch where content is null;
select /*+ opt_param('rowsets_max_rows', 64) */ id, json_length(ai_embed('enhance_embed', content)) as dimension from ai_enhance_batch where id < 44 order by id limit 3;
drop table ai_enhance_batch;

--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_rerank');
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_rerank_ep');
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
  'enhance_rerank', '{"type":"rerank","model_name":"BAAI/bge-reranker-v2-m3"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT(
  'enhance_rerank_ep', '{"ai_model_name":"enhance_rerank","scope":"all","url":"http://0.0.0.0:8000/v1/rerank","access_key":"mock-key","provider":"siliconflow"}');
select json_length(ai_rerank('enhance_rerank','apple',
       '["apple","banana","fruit","vegetable"]', null)) as rerank_count;
select json_unquote(json_extract(r, '$[0].id')) as first_id,
       json_length(r) as rerank_count
  from (select ai_rerank('enhance_rerank','apple',
        '[{"id":"a","text":"apple"},{"id":"b","text":"banana"}]',
        'text') as r) x;

select json_length(ai_rerank('enhance_rerank', 'apple', json_array('apple','banana'), null, 1)) as rerank_top_count;
select json_extract(ai_rerank('enhance_rerank', 'apple', '[{"id":"a","text":"apple","tag":7},{"id":"b","text":"banana","tag":8}]', 'text', 1), '$[0].tag') as rerank_top_tag;

--disable_query_log
--disable_result_log
--error 1210
select ai_rerank('enhance_rerank', 'apple', '[]', null);
--error 1210
select ai_rerank('enhance_rerank', 'apple', '["apple",null]', null);
--error 1210
select ai_rerank('enhance_rerank', 'apple', '["apple",{}]', null);
--error 1210
select ai_rerank('enhance_rerank', 'apple', '[{}]', 'text');
--error 1210
select ai_rerank('enhance_rerank', 'apple', '[{"text":1}]', 'text');
--error 1210
select ai_rerank('enhance_rerank', 'apple', '[{"text":""}]', 'text');
--error 1210
select ai_rerank('enhance_rerank', 'apple', '["apple"]', null, 0);
--error 1210
select ai_rerank('enhance_rerank', 'apple', '["apple"]', null, 2);
--error 1210
select ai_rerank('enhance_rerank', 'apple', '["apple"]', null, 0.5);
--error 1210
select ai_rerank('enhance_rerank', 'apple', '["apple"]', null, cast(18446744073709551615 as unsigned));
--error 3141
select ai_rerank('enhance_rerank', 'apple', '[invalid', null);
--enable_result_log
--enable_query_log

# Ollama provider: access_key 可为空，completion/embed 走原生协议
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_ollama_complete');
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_ollama_complete_ep');
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
  'enhance_ollama_complete', '{"type":"completion","model_name":"qwen2.5"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT(
  'enhance_ollama_complete_ep', '{"ai_model_name":"enhance_ollama_complete","scope":"all","url":"http://0.0.0.0:8000/api/generate","access_key":"","provider":"ollama"}');
select provider from oceanbase.DBA_OB_AI_MODEL_ENDPOINTS
 where endpoint_name = 'enhance_ollama_complete_ep';
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT(
  'enhance_ollama_complete_ep', '{"provider":"Ollama"}');
select provider from oceanbase.DBA_OB_AI_MODEL_ENDPOINTS
 where endpoint_name = 'enhance_ollama_complete_ep';
select length(ai_complete('enhance_ollama_complete', 'hello')) > 0 as ollama_complete_ok;
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('enhance_ollama_complete_ep', '{"provider":"openai","access_key":"mock-key"}');
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('enhance_ollama_complete_ep', '{"provider":"OLLAMA","access_key":null}');
select provider, coalesce(length(access_key), 0) = 0 as no_key from oceanbase.DBA_OB_AI_MODEL_ENDPOINTS where endpoint_name = 'enhance_ollama_complete_ep';
select length(ai_complete('enhance_ollama_complete', 'hello', json_object('temperature',0.5,'max_tokens',16))) > 0 as ollama_options_ok;
--disable_query_log
--disable_result_log
--error 11116
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('enhance_ollama_complete_ep', '{"provider":"not-a-provider"}');
--error 11114
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('enhance_ollama_complete_ep', null);
--error 11114
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('enhance_ollama_complete_ep', '{"provider":"openai","access_key":""}');
--enable_result_log
--enable_query_log

--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_ollama_embed');
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_ollama_embed_ep');
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
  'enhance_ollama_embed', '{"type":"dense_embedding","model_name":"nomic-embed-text"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT(
  'enhance_ollama_embed_ep', '{"ai_model_name":"enhance_ollama_embed","scope":"all","url":"http://0.0.0.0:8000/api/embed","provider":"OLLAMA"}');
select json_valid(ai_embed('enhance_ollama_embed', 'hello')) as ollama_embed_ok;

call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_complete');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_complete_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_embed');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_embed_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_rerank');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_rerank_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_ollama_complete');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_ollama_complete_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('enhance_ollama_embed');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('enhance_ollama_embed_ep');
select count(*) as ollama_endpoints_left from oceanbase.DBA_OB_AI_MODEL_ENDPOINTS where endpoint_name in ('enhance_ollama_complete_ep', 'enhance_ollama_embed_ep');
